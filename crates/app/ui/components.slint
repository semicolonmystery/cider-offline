// Design tokens and the small custom controls every page is built from:
// buttons, list rows, toggles and the download state control.

import { Palette, Spinner } from "std-widgets.slint";
import { Icons } from "icons.slint";

export { Icons }

/// Design tokens (colours, type scale, geometry). Every colour has a dark
/// and a light value and follows the OS theme through `Palette.color-scheme`.
export global Theme {
    property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Surfaces.
    out property <color> bg-window: root.dark ? #1C1C1E : #FFFFFF;
    out property <color> bg-sidebar: root.dark ? #161618 : #F5F5F7;
    out property <color> bg-raised: root.dark ? #2C2C2E : #FFFFFF;
    out property <color> bg-fill: root.dark ? #FFFFFF14 : #0000000A;
    // Light raised surfaces get a hairline + shadow instead of a darker fill.
    out property <color> raised-border: root.dark ? #FFFFFF14 : #0000001A;
    out property <color> raised-shadow: root.dark ? #00000080 : #00000033;

    // Interaction overlays.
    out property <color> hover: root.dark ? #FFFFFF0F : #0000000A;
    out property <color> pressed: root.dark ? #FFFFFF1F : #00000014;
    out property <color> selected: root.dark ? #FFFFFF1A : #0000000F;
    out property <color> segment-thumb: root.dark ? #636366 : #FFFFFF;
    out property <color> segment-thumb-border: root.dark ? #00000000 : #0000001A;
    out property <color> separator: root.dark ? #FFFFFF14 : #0000001A;

    // Text.
    out property <color> text-primary: root.dark ? #F5F5F7 : #1D1D1F;
    out property <color> text-secondary: root.dark ? #98989D : #6E6E73;
    out property <color> text-tertiary: root.dark ? #636366 : #AEAEB2;

    // Accent and status.
    out property <color> accent: root.dark ? #FA2D48 : #FA243C;
    out property <color> accent-pressed: root.dark ? #D9213B : #D61F35;
    out property <color> accent-soft: root.accent.with-alpha(root.dark ? 0.18 : 0.12);
    out property <color> ok: root.dark ? #30D158 : #34C759;
    out property <color> warn: root.dark ? #FFD60A : #FF9F0A;
    out property <color> error: root.dark ? #FF453A : #FF3B30;
    out property <color> scrim: root.dark ? #00000099 : #00000066;
    out property <color> cover-placeholder: root.dark ? #2C2C2E : #E5E5EA;

    // Type scale.
    out property <length> large-title: 26px;
    out property <length> title: 24px;
    out property <length> headline: 15px;
    out property <length> body: 13px;
    out property <length> callout: 12px;
    out property <length> caption: 11px;

    // Geometry.
    out property <length> control-h: 32px;
    out property <length> row-h: 52px;
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
}

/// A vendored SVG icon drawn as an alpha mask in `tint`.
export component Icon inherits Image {
    in property <length> size: 20px;
    in property <brush> tint: Theme.text-secondary;
    width: root.size;
    height: root.size;
    colorize: root.tint;
    image-fit: contain;
    accessible-role: none;
}

/// Keyboard focus ring: a 2px accent outline. Place it 4px outside the
/// control (x/y -4px, size +8px) so showing it never moves the layout.
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <length> radius;
    border-radius: root.radius + 4px;
    border-width: root.shown ? 2px : 0px;
    border-color: Theme.accent;
}

/// Round icon-only button (32px, 20px icon). The tooltip doubles as the
/// accessible name.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <length> diameter: Theme.control-h;
    in property <length> icon-size: 20px;
    in property <brush> tint: Theme.text-secondary;
    in property <brush> hover-tint: Theme.text-primary;
    // A small accent dot in the top-right corner (e.g. "a filter in ⋯ is on").
    in property <bool> dot: false;
    // Dark translucent chip for use on top of artwork (white icon).
    in property <bool> chip: false;
    out property <bool> hovered: touch.has-hover;
    callback clicked;

    width: root.diameter;
    height: root.diameter;
    border-radius: root.diameter / 2;
    background: root.chip ? #00000080
        : !root.enabled ? transparent
        : touch.pressed ? Theme.pressed
        : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    opacity: root.enabled ? 1 : 0.4;

    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    if root.tooltip != "": Tooltip {
        text: @markdown("\{root.tooltip}");
    }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        size: root.icon-size;
        tint: root.chip ? #FFFFFF : touch.has-hover && root.enabled ? root.hover-tint : root.tint;
    }

    if root.dot: Rectangle {
        x: parent.width - self.width - 3px;
        y: 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    FocusRing {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        shown: focus.has-focus;
        radius: root.diameter / 2;
    }
}

/// Square icon toggle (32px, radius.sm). On: accent-soft fill, accent icon.
export component IconToggle inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> on;
    callback toggled();

    width: Theme.control-h;
    height: Theme.control-h;
    border-radius: Theme.radius-sm;
    background: root.on ? Theme.accent-soft
        : touch.pressed ? Theme.pressed
        : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 150ms; }

    accessible-role: switch;
    accessible-label: root.tooltip;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => {
        root.toggled();
    }

    Tooltip {
        text: @markdown("\{root.tooltip}");
    }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        tint: root.on ? Theme.accent : touch.has-hover ? Theme.text-primary : Theme.text-secondary;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.toggled();
                return accept;
            }
            reject
        }
    }

    FocusRing {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        shown: focus.has-focus;
        radius: Theme.radius-sm;
    }
}

/// Pill button: a label with an optional trailing chevron (source pill).
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> tooltip;
    in property <bool> chevron: true;
    callback clicked;

    height: Theme.control-h;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.selected : Theme.bg-fill;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: root.tooltip != "" ? root.tooltip : root.text;
    accessible-action-default => {
        root.clicked();
    }

    if root.tooltip != "": Tooltip {
        text: @markdown("\{root.tooltip}");
    }

    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: root.chevron ? 10px : 14px;
        spacing: 6px;
        Text {
            text: root.text;
            font-size: Theme.body;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        if root.chevron: Icon {
            y: (parent.height - self.height) / 2;
            source: Icons.chevron-down;
            size: 16px;
            tint: Theme.text-secondary;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    FocusRing {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        shown: focus.has-focus;
        radius: root.height / 2;
    }
}

/// Text-only segmented control (32px; track bg.fill, raised thumb).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <[string]> tooltips;
    in-out property <int> current: 0;
    callback changed(int);

    height: Theme.control-h;
    width: track.preferred-width;
    border-radius: Theme.radius-sm;
    background: Theme.bg-fill;
    accessible-role: tab-list;

    track := HorizontalLayout {
        padding: 2px;
        spacing: 0px;
        for opt[i] in root.options: Rectangle {
            border-radius: 5px;
            background: root.current == i ? Theme.segment-thumb : seg-touch.has-hover ? Theme.hover : transparent;
            border-width: root.current == i ? 1px : 0px;
            border-color: Theme.segment-thumb-border;
            animate background { duration: 150ms; }
            accessible-role: tab;
            accessible-label: opt;
            accessible-item-selected: root.current == i;
            accessible-action-default => {
                root.current = i;
                root.changed(i);
            }

            if i < root.tooltips.length && root.tooltips[i] != "": Tooltip {
                text: @markdown("\{root.tooltips[i]}");
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: opt;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    font-size: Theme.body;
                    font-weight: root.current == i ? 600 : 400;
                    color: root.current == i ? Theme.text-primary : Theme.text-secondary;
                }
            }

            seg-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

/// Icon-only segmented control: 32x28 icon segments.
export component IconSegmented inherits Rectangle {
    in property <[image]> icons;
    in property <[string]> labels;
    in-out property <int> current: 0;
    callback changed(int);

    height: Theme.control-h;
    width: 4px + root.icons.length * 32px;
    border-radius: Theme.radius-sm;
    background: Theme.bg-fill;
    accessible-role: tab-list;

    for icon[i] in root.icons: Rectangle {
        x: 2px + i * 32px;
        y: 2px;
        width: 32px;
        height: 28px;
        border-radius: 5px;
        background: root.current == i ? Theme.segment-thumb : seg-touch.has-hover ? Theme.hover : transparent;
        border-width: root.current == i ? 1px : 0px;
        border-color: Theme.segment-thumb-border;
        animate background { duration: 150ms; }
        accessible-role: tab;
        accessible-label: i < root.labels.length ? root.labels[i] : "";
        accessible-item-selected: root.current == i;
        accessible-action-default => {
            root.current = i;
            root.changed(i);
        }

        if i < root.labels.length: Tooltip {
            text: @markdown("\{root.labels[i]}");
        }

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: icon;
            size: 18px;
            tint: root.current == i ? Theme.text-primary : Theme.text-secondary;
        }

        seg-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.current = i;
                root.changed(i);
            }
        }
    }
}

/// Text button. `kind`: "primary" (filled accent), "destructive" (filled
/// red), "secondary" (tonal), "plain" (accent text, no fill).
export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    callback clicked;

    property <bool> filled: root.kind == "primary" || root.kind == "destructive";
    property <color> fill: root.kind == "primary" ? (touch.pressed ? Theme.accent-pressed : Theme.accent)
        : root.kind == "destructive" ? Theme.error
        : root.kind == "secondary" ? (touch.pressed ? Theme.pressed : touch.has-hover ? Theme.selected : Theme.bg-fill)
        : (touch.has-hover ? Theme.hover : transparent);

    // Smallest width (filled and tonal buttons).
    in property <length> min-w: root.kind == "plain" ? 0px : 72px;

    height: Theme.control-h;
    width: max(root.min-w, label.preferred-width + (root.kind == "plain" ? 12px : 28px));
    border-radius: Theme.radius-sm;
    background: root.fill;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    label := Text {
        text: root.text;
        font-size: Theme.body;
        font-weight: root.filled ? 600 : 400;
        color: root.filled ? #FFFFFF : root.kind == "plain" ? Theme.accent : Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    FocusRing {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        shown: focus.has-focus;
        radius: Theme.radius-sm;
    }
}

/// Search field: glyph, single-line input, placeholder and clear button.
export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search";
    callback edited(string);
    callback cleared();

    height: Theme.control-h;
    border-radius: Theme.radius-sm;
    background: Theme.bg-fill;
    accessible-role: text-input;
    accessible-label: root.placeholder;
    accessible-value: root.text;

    public function focus-input() {
        input.focus();
    }

    Icon {
        x: 9px;
        y: (parent.height - self.height) / 2;
        source: Icons.search;
        size: 16px;
        tint: Theme.text-secondary;
    }

    if root.text == "": Text {
        x: 32px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.placeholder;
        font-size: Theme.body;
        color: Theme.text-tertiary;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 32px;
        width: parent.width - 32px - (root.text == "" ? 8px : 32px);
        height: parent.height;
        text <=> root.text;
        font-size: Theme.body;
        color: Theme.text-primary;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.accent.with-alpha(0.35);
        edited => {
            root.edited(self.text);
        }
        key-pressed(event) => {
            if event.text == Key.Escape && self.text != "" {
                self.text = "";
                root.edited("");
                root.cleared();
                return accept;
            }
            reject
        }
    }

    if root.text != "": IconButton {
        x: parent.width - self.width - 4px;
        y: (parent.height - self.height) / 2;
        diameter: 24px;
        icon-size: 14px;
        icon: Icons.close;
        tooltip: "Clear search";
        clicked => {
            root.text = "";
            root.edited("");
            root.cleared();
        }
    }

    FocusRing {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        shown: input.has-focus;
        radius: Theme.radius-sm;
    }
}

/// Coloured dot (proxy status).
export component Dot inherits Rectangle {
    in property <color> tone;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.tone;
}

/// "Custom" badge (16px pill, accent-soft fill, accent text).
export component Badge inherits Rectangle {
    in property <string> text: "Custom";
    in property <color> tone: Theme.accent;
    height: 16px;
    width: label.preferred-width + 12px;
    border-radius: self.height / 2;
    background: root.tone.with-alpha(0.16);

    label := Text {
        text: root.text;
        color: root.tone;
        font-size: Theme.caption;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Sidebar navigation entry (full width, or a 40x32 rail button).
export component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> rail: false;
    callback clicked;

    height: 32px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.selected : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    if root.rail: Tooltip {
        text: @markdown("\{root.text}");
    }

    if root.rail: Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        tint: root.selected ? Theme.accent : Theme.text-secondary;
    }

    if !root.rail: HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            tint: root.selected ? Theme.accent : Theme.text-secondary;
        }

        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.body;
            font-weight: root.selected ? 600 : 400;
            color: Theme.text-primary;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    FocusRing {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        shown: focus.has-focus;
        radius: Theme.radius-sm;
    }
}

/// Large two-state switch used for Active / Passthrough.
export component BigToggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 64px;
    height: 36px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : Theme.text-tertiary.with-alpha(0.6);
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 150ms; }

    accessible-role: switch;
    accessible-label: "Active mode";
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        touch.clicked();
    }

    Rectangle {
        width: 30px;
        height: 30px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: 15px;
        background: white;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        animate x { duration: 150ms; easing: ease-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

/// Square artwork with a placeholder glyph when there is no image.
export component Artwork inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <length> size: 36px;
    in property <length> radius: Theme.radius-xs;
    // Glyph shown without art: Icons.song / Icons.album / Icons.playlist.
    in property <image> placeholder-icon: Icons.song;
    width: root.size;
    height: root.size;
    border-radius: root.radius;
    clip: true;
    background: Theme.cover-placeholder;

    if !root.has-image: Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.placeholder-icon;
        size: root.size * 0.4;
        tint: Theme.text-tertiary;
    }

    if root.has-image: Image {
        width: root.size;
        height: root.size;
        source: root.source;
        image-fit: ImageFit.cover;
    }
}

/// Skeleton block (placeholder geometry).
export component Skeleton inherits Rectangle {
    border-radius: Theme.radius-xs;
    background: Theme.cover-placeholder;
}

/// Determinate circular progress ring.
///
/// `progress` is `0.0..=1.0`; the arc is stroked in `ring-color` over a faint
/// full-circle track, clockwise from 12 o'clock.
export component CircularProgress inherits Rectangle {
    in property <float> progress;
    in property <color> ring-color: Theme.accent;
    in property <color> track-color: Theme.text-tertiary.with-alpha(0.35);
    in property <length> ring-size: 22px;
    in property <length> stroke-width: 2.5px;

    width: root.ring-size;
    height: root.ring-size;

    // Clamp away from the degenerate full-turn endpoint (start == end).
    property <float> p: min(max(root.progress, 0), 0.999);
    // Centre / radius in the Path's 1:1 pixel coordinate space.
    property <float> c: (root.ring-size / 1px) / 2;
    property <float> r: root.c - (root.stroke-width / 1px) / 2;

    // Faint full-circle track.
    Rectangle {
        border-radius: root.ring-size / 2;
        border-width: root.stroke-width;
        border-color: root.track-color;
    }

    // Progress arc, drawn clockwise from 12 o'clock to `progress` x 360deg.
    //
    // The viewbox pins the arc to the ring's own coordinates. Without it a
    // Path scales its *bounding box* to fill the element, so a partial arc
    // was stretched and its start point drifted as progress grew. A Path
    // insets its fitting area by half the stroke on each side, so the
    // viewbox is inset the same way to keep the mapping exactly 1:1.
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: (root.stroke-width / 1px) / 2;
        viewbox-y: (root.stroke-width / 1px) / 2;
        viewbox-width: (root.ring-size - root.stroke-width) / 1px;
        viewbox-height: (root.ring-size - root.stroke-width) / 1px;
        stroke: root.ring-color;
        stroke-width: root.stroke-width;
        fill: transparent;
        // A complete ring is two half-turn arcs (a single arc whose start and
        // end coincide is degenerate and would draw nothing).
        commands: root.progress <= 0.001
            ? ""
            : root.progress >= 0.999
            ? "M \{root.c} \{root.c - root.r} A \{root.r} \{root.r} 0 0 1 \{root.c} \{root.c + root.r} A \{root.r} \{root.r} 0 0 1 \{root.c} \{root.c - root.r}"
            : "M \{root.c} \{root.c - root.r} A \{root.r} \{root.r} 0 \{root.p >= 0.5 ? 1 : 0} 1 \{root.c + root.r * Math.sin(root.p * 360deg)} \{root.c - root.r * Math.cos(root.p * 360deg)}";
    }
}

/// Download state indicator and control, shown on track rows and collection
/// headers.
///
/// `status` is "" | "queued" | "downloading" | "paused" | "failed" | "done" |
/// "unavailable" (a muted, non-interactive "Can't download yet" glyph);
/// `downloaded` marks an item already available locally. Idle shows a
/// download button, active states a ring with a pause / play / retry glyph,
/// done a check. With `can-toggle` the ring pauses / resumes / retries.
export component DownloadControl inherits Rectangle {
    in property <string> status;
    in property <float> progress;
    in property <bool> downloaded;
    in property <length> ring-size: 24px;
    in property <bool> can-toggle: true;
    // Draw the idle "download" button (rows show it only on hover).
    in property <bool> show-idle: true;
    // White tones for use on a dark chip over artwork.
    in property <bool> on-dark: false;
    // What is downloaded ("album", "playlist"), for the idle tooltip.
    in property <string> label;
    // Short failure reason appended to the failed tooltip.
    in property <string> reason;
    callback start();
    callback toggle();

    property <bool> queued: root.status == "queued";
    property <bool> running: root.status == "downloading";
    property <bool> paused: root.status == "paused";
    property <bool> failed: root.status == "failed";
    property <bool> active: root.queued || root.running || root.paused || root.failed;
    property <bool> is-done: !root.active && (root.downloaded || root.status == "done");
    property <bool> unavailable: !root.active && !root.is-done && root.status == "unavailable";
    property <bool> idle: !root.active && !root.is-done && !root.unavailable;
    property <length> stroke: root.ring-size <= 24px ? 2px : 2.5px;

    property <color> secondary: root.on-dark ? #FFFFFFB3 : Theme.text-secondary;
    property <color> tertiary: root.on-dark ? #FFFFFFD9 : Theme.text-tertiary;
    property <color> live: root.on-dark ? #FFFFFF : Theme.accent;

    property <string> hint: root.is-done ? "Downloaded"
        : root.unavailable ? (root.reason == "" ? "Can't download yet" : "Can't download yet. " + root.reason)
        : root.idle ? (root.label == "" ? "Download" : "Download " + root.label)
        : root.failed ? (root.reason == "" ? "Download failed. Click to retry." : "Download failed. Click to retry. " + root.reason)
        : root.paused ? "Paused. Click to resume."
        : root.queued ? "Waiting to download. Click to pause."
        : "Downloading, \{Math.round(root.progress * 100)}%. Click to pause.";

    width: root.ring-size;
    height: root.ring-size;

    accessible-role: button;
    accessible-label: root.hint;
    accessible-action-default => {
        if root.active && root.can-toggle {
            root.toggle();
        } else if root.idle {
            root.start();
        }
    }

    if (root.idle && root.show-idle) || !root.idle: Tooltip {
        text: @markdown("\{root.hint}");
    }

    // Idle: start-download button at full ring size.
    if root.idle && root.show-idle: Rectangle {
        Icon {
            source: Icons.download;
            size: root.ring-size;
            tint: idle-touch.has-hover ? Theme.accent : root.secondary;
        }

        idle-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.start();
            }
        }
    }

    // Can't download yet: muted glyph, nothing to click.
    if root.unavailable: Icon {
        source: Icons.unavailable;
        size: root.ring-size;
        tint: root.tertiary;
        opacity: 0.7;
    }

    // Done: check at full size.
    if root.is-done: Icon {
        source: Icons.done;
        size: root.ring-size;
        tint: root.tertiary;
    }

    // Active: ring + centre glyph.
    if root.active: CircularProgress {
        ring-size: root.ring-size;
        stroke-width: root.stroke;
        track-color: root.on-dark ? #FFFFFF59 : Theme.text-tertiary.with-alpha(0.35);
        progress: root.failed ? 1.0 : root.queued ? 0.0 : root.progress;
        ring-color: root.failed ? Theme.error : root.paused ? root.secondary : root.live;
    }

    if root.active: Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.ring-size * 0.5;
        source: root.failed ? Icons.retry : root.paused ? Icons.play : Icons.pause;
        tint: root.failed ? Theme.error : root.running ? root.live : root.secondary;
    }

    if root.active && root.can-toggle: TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggle();
        }
    }
}

/// Transient status message shown over the bottom of a page.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> is-error;
    callback close();

    // Width the content wants; the page clamps the toast's width to it.
    out property <length> natural-width: row.preferred-width;
    height: 36px;
    width: self.natural-width;
    border-radius: Theme.radius-md;
    background: Theme.bg-raised;
    border-width: 1px;
    border-color: Theme.raised-border;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.raised-shadow;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    Tooltip {
        text: @markdown("\{root.text}");
    }

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: root.is-error ? 4px : 14px;
        spacing: 8px;

        if root.is-error: Icon {
            y: (parent.height - self.height) / 2;
            source: Icons.alert;
            size: 16px;
            tint: Theme.error;
        }

        Text {
            text: root.text;
            font-size: Theme.body;
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.is-error: IconButton {
            y: (parent.height - self.height) / 2;
            diameter: 28px;
            icon-size: 14px;
            icon: Icons.close;
            tooltip: "Dismiss";
            clicked => {
                root.close();
            }
        }
    }
}

/// Inline busy indicator sized like an icon slot.
export component Busy inherits Rectangle {
    in property <length> size: 18px;
    width: root.size;
    height: root.size;
    Spinner {
        width: root.size;
        height: root.size;
        indeterminate: true;
    }
}

/// Section heading of a grouped inset list (sentence case).
export component GroupHeading inherits Text {
    font-size: Theme.headline;
    font-weight: 600;
    color: Theme.text-primary;
}

/// Container of a grouped inset list (bg.fill, radius.md). Put `ListRow`s
/// and `RowSeparator`s inside.
export component Group inherits Rectangle {
    border-radius: Theme.radius-md;
    background: Theme.bg-fill;
    // Height for the actual width, so wrapped descriptions get their lines.
    height: inner.preferred-height;

    inner := VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        @children
    }
}

/// Inset hairline between grouped-list rows.
export component RowSeparator inherits Rectangle {
    height: 1px;
    background: Theme.separator;
}

/// One row of a grouped inset list: title (+ status line, + description) on
/// the left, the row's controls (children) on the right. At least 44px high.
/// The optional status line sits under the title with a `status-tone` dot.
export component ListRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in property <color> title-color: Theme.text-primary;
    in property <string> status;
    in property <color> status-tone: Theme.text-tertiary;
    spacing: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    min-height: 44px;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: Theme.body;
            color: root.title-color;
        }

        if root.status != "": HorizontalLayout {
            spacing: 6px;
            // Centred on the first line of the (possibly wrapped) status text.
            VerticalLayout {
                alignment: start;
                padding-top: (status-text.font-size * 1.25 - 8px) / 2;
                Dot {
                    tone: root.status-tone;
                }
            }

            status-text := Text {
                horizontal-stretch: 1;
                text: root.status;
                wrap: word-wrap;
                font-size: Theme.callout;
                color: Theme.text-primary;
            }
        }

        if root.description != "": Text {
            text: root.description;
            wrap: word-wrap;
            font-size: Theme.callout;
            color: Theme.text-secondary;
        }
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                @children
            }
        }
    }
}

/// Large page title (+ optional secondary line).
export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 2px;

    Text {
        text: root.title;
        font-size: Theme.large-title;
        font-weight: 700;
        color: Theme.text-primary;
        overflow: elide;
    }

    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: Theme.callout;
        color: Theme.text-secondary;
        overflow: elide;
    }
}
