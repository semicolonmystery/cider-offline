// The only place that names the vendored icon files (Hugeicons free,
// "Stroke Rounded", MIT; see icons/LICENSE-hugeicons.txt).
//
// Every file is a 24x24 black-on-transparent SVG. Draw them through `Icon`,
// which uses the image as an alpha mask (`colorize`) so one file serves every
// theme and state.

export global Icons {
    out property <image> overview: @image-url("icons/dashboard-speed-02.svg");
    out property <image> library: @image-url("icons/library.svg");
    out property <image> settings: @image-url("icons/settings-02.svg");
    out property <image> search: @image-url("icons/search-01.svg");
    out property <image> close: @image-url("icons/cancel-01.svg");
    out property <image> grid: @image-url("icons/grid-view.svg");
    out property <image> list: @image-url("icons/list-view.svg");
    out property <image> missing-audio: @image-url("icons/music-note-03.svg");
    out property <image> missing-lyrics: @image-url("icons/quote-down.svg");
    out property <image> chevron-down: @image-url("icons/arrow-down-01.svg");
    out property <image> more: @image-url("icons/more-horizontal.svg");
    out property <image> add: @image-url("icons/add-01.svg");
    out property <image> download: @image-url("icons/circle-arrow-down-01.svg");
    out property <image> pause: @image-url("icons/pause-solid.svg");
    out property <image> play: @image-url("icons/play-solid.svg");
    out property <image> done: @image-url("icons/checkmark-circle-02.svg");
    // Every song is on disk, but through other downloads, not this album's
    // or playlist's own (Hugeicons Link02Icon).
    out property <image> linked-elsewhere: @image-url("icons/link-02.svg");
    out property <image> retry: @image-url("icons/arrow-reload-horizontal.svg");
    out property <image> alert: @image-url("icons/alert-circle.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> lyrics: @image-url("icons/quote-down.svg");
    // Line-synced lyrics (Hugeicons SubtitleIcon).
    out property <image> lyrics-synced: @image-url("icons/subtitle.svg");
    // Word-synced (karaoke) lyrics (Hugeicons Mic01Icon).
    out property <image> lyrics-word: @image-url("icons/mic-01.svg");
    // Move up in a list (Hugeicons ArrowUp01Icon); down is `chevron-down`.
    out property <image> chevron-up: @image-url("icons/arrow-up-01.svg");
    // A download that can never happen (Hugeicons UnavailableIcon).
    out property <image> unavailable: @image-url("icons/unavailable.svg");
    out property <image> edit: @image-url("icons/pencil-edit-02.svg");
    out property <image> delete: @image-url("icons/delete-02.svg");
    out property <image> back: @image-url("icons/arrow-left-01.svg");
    out property <image> grip: @image-url("icons/drag-drop-vertical.svg");
    out property <image> song: @image-url("icons/music-note-01.svg");
    out property <image> album: @image-url("icons/disc-album.svg");
    out property <image> playlist: @image-url("icons/play-list.svg");
    out property <image> audio-file: @image-url("icons/file-music.svg");
    out property <image> image-file: @image-url("icons/file-import.svg");
    out property <image> folder: @image-url("icons/folder-01.svg");
    // A downloaded spatial mix (Hugeicons HeadphonesIcon plus sound-wave bars).
    out property <image> spatial: @image-url("icons/headphones-spatial.svg");
}
