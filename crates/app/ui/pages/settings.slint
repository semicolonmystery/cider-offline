import { SpinBox, Switch, ScrollView, ComboBox, CheckBox } from "std-widgets.slint";
import {
    Theme, Icons, Icon, IconButton, ActionButton, Group, GroupHeading, ListRow, RowSeparator,
    PageTitle, Dot,
} from "../components.slint";
import { SettingsState, ProxyState, CiderState } from "../globals.slint";

/// A heading plus its grouped inset list.
component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;

    GroupHeading {
        text: root.title;
    }

    Group {
        @children
    }
}

/// Settings page: grouped inset lists.
export component SettingsPage inherits Rectangle {
    property <length> pad: root.width >= 1100px ? 32px : 24px;
    // Certificate row status line (dot + text under the row title). States
    // come from `TrustState::ui_key`: trusted, untrusted, error; plus checking.
    property <string> trust-status: ProxyState.trust-busy ? "Working…"
        : ProxyState.trust-state == "trusted"
        ? (ProxyState.trust-message != "" ? ProxyState.trust-message : "Trusted by this computer")
        : ProxyState.trust-state == "untrusted" ? "Not installed"
        : ProxyState.trust-state == "checking" ? "Checking…" : "Needs attention";
    property <color> trust-tone: ProxyState.trust-busy || ProxyState.trust-state == "checking" ? Theme.text-tertiary
        : ProxyState.trust-state == "trusted" ? Theme.ok
        : ProxyState.trust-state == "untrusted" ? Theme.warn : Theme.error;

    // Mounted each time the page opens: re-count the unlinked downloads, and
    // scroll to the section the Overview's issue line asked for.
    init => {
        SettingsState.refresh-unlinked();
        root.reveal(SettingsState.focus-section);
        SettingsState.focus-section = "";
    }

    function reveal(section: string) {
        if section == "" {
            return;
        }
        // Put the section's heading at the top, as far as the page scrolls.
        scroll.content-y = min(0px, max(
            -(section == "certificate" ? certificate.y
                : section == "cider" ? cider.y
                : section == "startup" ? startup.y
                : section == "downloads" ? downloads.y
                : section == "library" ? library.y
                : section == "lyrics" ? lyrics.y
                : section == "storage" ? storage.y
                : proxy.y),
            scroll.visible-height - scroll.content-height));
    }

    VerticalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        padding-top: 16px;
        spacing: 8px;

        PageTitle {
            height: 56px;
            title: "Settings";
            subtitle: SettingsState.message;
        }

        scroll := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 24px;
                padding-bottom: root.pad;
                // Keep clear of the scrollbar.
                padding-right: 12px;

                proxy := Section {
                    title: "Proxy";
                    ListRow {
                        title: ProxyState.starting ? "Starting…"
                            : !ProxyState.running ? "Proxy stopped"
                            : ProxyState.online ? "Online" : "Offline, serving from this computer";
                        description: ProxyState.last-error != "" ? ProxyState.last-error
                            : ProxyState.running && ProxyState.online ? "Apple Music is reachable." : "";
                        Dot {
                            tone: !ProxyState.running ? Theme.error : ProxyState.online ? Theme.ok : Theme.warn;
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Address";
                        description: ProxyState.address;
                        address := TextInput {
                            width: 0px;
                            height: 0px;
                            read-only: true;
                            text: ProxyState.address;
                        }

                        ActionButton {
                            text: "Copy";
                            clicked => {
                                address.select-all();
                                address.copy();
                                address.clear-selection();
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Port";
                        description: "Cider must use 127.0.0.1 and this port as its HTTP and HTTPS proxy. Changing it restarts the proxy.";
                        SpinBox {
                            width: 120px;
                            minimum: 1;
                            maximum: 65535;
                            value <=> SettingsState.port;
                        }

                        ActionButton {
                            text: "Apply";
                            kind: "primary";
                            enabled: SettingsState.port != SettingsState.applied-port;
                            clicked => {
                                SettingsState.apply-port(SettingsState.port);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Apple Music session";
                        status: ProxyState.session-captured ? "Captured" : "Not captured yet";
                        status-tone: ProxyState.session-captured ? Theme.ok : Theme.warn;
                        description: ProxyState.session-captured
                            ? "Taken from Cider's requests. Library sync and downloads use it."
                            : "Play a song in Cider while it uses the proxy in Active mode. Library sync and downloads need it.";
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Requests seen";
                        Text {
                            text: ProxyState.requests-seen;
                            font-size: Theme.body;
                            color: Theme.text-secondary;
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Served from this computer";
                        Text {
                            text: ProxyState.served-locally;
                            font-size: Theme.body;
                            color: Theme.text-secondary;
                        }
                    }
                }

                certificate := Section {
                    title: "Certificate";
                    ListRow {
                        title: "Certificate";
                        status: root.trust-status;
                        status-tone: root.trust-tone;
                        // A trusted CA's note (if any) is the status itself.
                        description: ProxyState.trust-state == "trusted" ? "" : ProxyState.trust-message;

                        if ProxyState.trust-state != "trusted" && ProxyState.trust-state != "checking": ActionButton {
                            text: ProxyState.trust-state == "untrusted" ? "Install" : "Fix";
                            kind: "primary";
                            enabled: !ProxyState.trust-busy;
                            clicked => {
                                ProxyState.install-ca();
                            }
                        }

                        ActionButton {
                            text: "Check again";
                            enabled: !ProxyState.trust-busy;
                            clicked => {
                                ProxyState.recheck-ca();
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Uninstall certificate";
                        description: "Remove the local certificate authority from the system. Cider stops working through the proxy in Active mode.";
                        ActionButton {
                            text: "Uninstall";
                            kind: "plain";
                            clicked => {
                                SettingsState.uninstall-ca();
                            }
                        }
                    }
                }

                cider := Section {
                    title: "Cider";
                    if CiderState.automatic: VerticalLayout {
                        ListRow {
                            title: "Route Cider through this proxy";
                            description: !CiderState.available
                                ? (CiderState.message != "" ? CiderState.message : "Cider's settings file was not found. Choose it to continue.")
                                : CiderState.message != "" ? CiderState.message
                                : CiderState.routed ? "Changing this restarts Cider." : "Turning this on edits Cider's settings and restarts it.";
                            Switch {
                                checked <=> CiderState.routed;
                                enabled: CiderState.available && !CiderState.busy;
                                toggled => {
                                    CiderState.set-routed(self.checked);
                                }
                            }
                        }

                        // The settings file in use and the picker, each on its
                        // own line: the path can be long and wraps anywhere.
                        VerticalLayout {
                            padding-bottom: 12px;
                            spacing: 8px;
                            if CiderState.config-path != "": Text {
                                text: "Settings file: " + CiderState.config-path;
                                wrap: char-wrap;
                                font-size: Theme.callout;
                                color: Theme.text-secondary;
                            }

                            HorizontalLayout {
                                alignment: start;
                                ActionButton {
                                    text: "Choose config file…";
                                    enabled: !CiderState.busy;
                                    clicked => {
                                        CiderState.choose-config();
                                    }
                                }
                            }
                        }
                    }

                    if !CiderState.automatic: ListRow {
                        title: "Use Cider with this proxy";
                        description: CiderState.guide;
                    }
                }

                startup := Section {
                    title: "Startup";
                    ListRow {
                        title: "Start with the system";
                        description: SettingsState.autostart-supported ? "Launch automatically when you sign in." : "Not supported on this system.";
                        Switch {
                            enabled: SettingsState.autostart-supported;
                            checked <=> SettingsState.start-with-os;
                            toggled => {
                                SettingsState.set-start-with-os(self.checked);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Start minimized";
                        description: "Start hidden in the system tray.";
                        Switch {
                            checked <=> SettingsState.start-minimized;
                            toggled => {
                                SettingsState.set-start-minimized(self.checked);
                            }
                        }
                    }
                }

                downloads := Section {
                    title: "Downloads";
                    ListRow {
                        title: "Download format";
                        description: "Which mix of a song a download saves. Spatial = the Dolby Atmos mix rendered for headphones.";
                        ComboBox {
                            width: 190px;
                            model: ["Stereo only", "Spatial where available", "Stereo + Spatial"];
                            current-index <=> SettingsState.download-format;
                            selected => {
                                SettingsState.set-download-format(self.current-index);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Play the other downloaded mix";
                        description: "When Cider asks for a mix you haven't downloaded (stereo or spatial), play the one you did download instead of streaming from Apple. Offline, this always happens.";
                        Switch {
                            checked <=> SettingsState.play-other-mix;
                            toggled => {
                                SettingsState.set-play-other-mix(self.checked);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Remove lyrics when removing downloads";
                        description: "Removing a song's download also deletes the lyrics the app fetched for it. Lyrics you imported are kept.";
                        Switch {
                            checked <=> SettingsState.remove-lyrics-with-downloads;
                            toggled => {
                                SettingsState.set-remove-lyrics-with-downloads(self.checked);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Download played songs";
                        description: "Off, right away, or once playback has been idle for 30 seconds.";
                        ComboBox {
                            width: 150px;
                            model: ["Off", "Right away", "When idle"];
                            current-index <=> SettingsState.auto-cache-mode;
                            selected => {
                                SettingsState.set-auto-cache-mode(self.current-index);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Simultaneous downloads";
                        description: "How many songs download at once. Apple may refuse licenses when too many are requested together, so 2 is the most reliable. Applies right away.";
                        ComboBox {
                            width: 150px;
                            model: ["1", "2", "3", "4", "5", "6"];
                            current-index: SettingsState.download-concurrency - 1;
                            selected => {
                                SettingsState.set-download-concurrency(self.current-index + 1);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Unlinked downloads";
                        description: "Downloaded songs no album, playlist or single download needs any more, for example after a song left a playlist or a playlist was deleted. Custom audio and links to local files are never touched.";
                        ComboBox {
                            width: 150px;
                            model: ["Manual", "Automatically"];
                            current-index <=> SettingsState.unlinked-mode;
                            selected => {
                                SettingsState.set-unlinked-mode(self.current-index);
                            }
                        }
                    }

                    if SettingsState.unlinked-mode == 1: RowSeparator { }

                    if SettingsState.unlinked-mode == 1: ListRow {
                        title: "Check every";
                        description: "Hours between automatic clean-ups (1 to 168). The first one runs about 10 minutes after the app starts.";
                        SpinBox {
                            width: 120px;
                            minimum: 1;
                            maximum: 168;
                            value <=> SettingsState.unlinked-hours;
                            edited(value) => {
                                SettingsState.set-unlinked-hours(value);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Clean up now";
                        description: SettingsState.unlinked-summary;
                        ActionButton {
                            text: "Clean up now…";
                            kind: "plain";
                            enabled: SettingsState.unlinked-count > 0;
                            clicked => {
                                SettingsState.clean-up-unlinked();
                            }
                        }
                    }
                }

                library := Section {
                    title: "Library";
                    ListRow {
                        title: "Detail level";
                        description: "Full keeps every song attribute for a rich library, search and lyrics. Minimal keeps only the core fields.";
                        ComboBox {
                            width: 150px;
                            model: ["Full", "Minimal"];
                            current-index <=> SettingsState.detail-level;
                            selected => {
                                SettingsState.set-detail-level(self.current-index);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Overwrite audio";
                        description: "Replace a song's existing audio when importing or downloading it again.";
                        Switch {
                            checked <=> SettingsState.overwrite-audio;
                            toggled => {
                                SettingsState.set-overwrite-audio(self.checked);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Songs page";
                        description: "What Cider's Library > Songs page lists, online and offline: only the songs you added to your library (like Apple Music), or every song in your library, including every song of your playlists.";
                        ComboBox {
                            width: 150px;
                            model: ["Added to library", "Every song"];
                            current-index <=> SettingsState.songs-page;
                            selected => {
                                SettingsState.set-songs-page(self.current-index);
                            }
                        }
                    }

                }

                lyrics := Section {
                    title: "Lyrics";
                    for provider[index] in SettingsState.lyrics-providers: VerticalLayout {
                        if index > 0: RowSeparator { }
                        ListRow {
                            title: provider.name;
                            description: provider.note;
                            IconButton {
                                icon: Icons.chevron-up;
                                icon-size: 16px;
                                tooltip: "Ask \{provider.name} earlier";
                                enabled: index > 0;
                                clicked => {
                                    SettingsState.move-lyrics-provider(provider.id, true);
                                }
                            }

                            IconButton {
                                icon: Icons.chevron-down;
                                icon-size: 16px;
                                tooltip: "Ask \{provider.name} later";
                                enabled: index < SettingsState.lyrics-providers.length - 1;
                                clicked => {
                                    SettingsState.move-lyrics-provider(provider.id, false);
                                }
                            }

                            Switch {
                                checked: provider.enabled;
                                toggled => {
                                    SettingsState.set-lyrics-provider-enabled(provider.id, self.checked);
                                }
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "When a lookup fails";
                        description: SettingsState.lyrics-failure-policy == 1
                            ? "Wait (up to 30 seconds) and ask again before moving on to the next song."
                            : SettingsState.lyrics-failure-policy == 2
                            ? "Move on. The song stays without lyrics until you fetch again."
                            : "Move on at once and ask again for the skipped songs once the rest are done.";
                        ComboBox {
                            width: 190px;
                            model: ["Skip, retry at the end", "Wait and retry", "Skip"];
                            current-index <=> SettingsState.lyrics-failure-policy;
                            selected => {
                                SettingsState.set-lyrics-failure-policy(self.current-index);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Search until";
                        description: "Providers are asked in order until lyrics this good are found. Otherwise the best ones found are kept.";
                        ComboBox {
                            width: 190px;
                            model: ["Word-synced (best)", "Line-synced", "Any lyrics"];
                            current-index <=> SettingsState.lyrics-target-quality;
                            selected => {
                                SettingsState.set-lyrics-target-quality(self.current-index);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Always use downloaded lyrics";
                        description: "Online too, show the lyrics saved here instead of asking Apple. Songs without saved lyrics still get Apple's. Imported lyrics files always win.";
                        Switch {
                            checked <=> SettingsState.lyrics-always-local;
                            toggled => {
                                SettingsState.set-lyrics-always-local(self.checked);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Fetch after downloading";
                        description: "Look lyrics up for every song once its download finishes.";
                        Switch {
                            checked <=> SettingsState.lyrics-after-download;
                            toggled => {
                                SettingsState.set-lyrics-after-download(self.checked);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Overwrite lyrics";
                        description: "Look songs that already have lyrics up again when fetching a collection or after a download. Apple lyrics are always kept.";
                        Switch {
                            checked <=> SettingsState.overwrite-lyrics;
                            toggled => {
                                SettingsState.set-overwrite-lyrics(self.checked);
                            }
                        }
                    }

                    RowSeparator { }

                    Rectangle {
                        height: 44px;
                        accessible-role: button;
                        accessible-label: "More options";
                        accessible-expandable: true;
                        accessible-expanded: SettingsState.lyrics-more-open;
                        accessible-action-default => {
                            SettingsState.lyrics-more-open = !SettingsState.lyrics-more-open;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: "More options";
                                font-size: Theme.body;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }

                            Icon {
                                y: (parent.height - self.height) / 2;
                                source: Icons.chevron-down;
                                size: 16px;
                                tint: Theme.text-secondary;
                                transform-rotation: SettingsState.lyrics-more-open ? 0deg : -90deg;
                                animate transform-rotation { duration: 150ms; }
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                SettingsState.lyrics-more-open = !SettingsState.lyrics-more-open;
                            }
                        }
                    }

                    if SettingsState.lyrics-more-open: VerticalLayout {
                        RowSeparator { }
                        // One checkbox per provider, stacked under the text:
                        // side by side they made the page wider than the
                        // window.
                        VerticalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 2px;
                            Text {
                                text: "Apply the failure rule to";
                                wrap: word-wrap;
                                font-size: Theme.body;
                                color: Theme.text-primary;
                            }

                            Text {
                                text: "Providers left unticked always wait and retry.";
                                wrap: word-wrap;
                                font-size: Theme.callout;
                                color: Theme.text-secondary;
                            }

                            VerticalLayout {
                                padding-top: 6px;
                                spacing: 6px;
                                alignment: start;
                                for provider in SettingsState.lyrics-providers: HorizontalLayout {
                                    alignment: start;
                                    CheckBox {
                                        text: provider.name;
                                        checked: provider.policy;
                                        toggled => {
                                            SettingsState.set-lyrics-policy-provider(provider.id, self.checked);
                                        }
                                    }
                                }
                            }
                        }

                        RowSeparator { }

                        ListRow {
                            title: "LRCLIB request spacing";
                            description: "Milliseconds between two LRCLIB lookups. Higher is gentler on LRCLIB's rate limit.";
                            SpinBox {
                                width: 120px;
                                minimum: 0;
                                maximum: 10000;
                                step-size: 50;
                                value <=> SettingsState.lrclib-spacing;
                                edited(value) => {
                                    SettingsState.set-lrclib-spacing(value);
                                }
                            }
                        }

                        RowSeparator { }

                        ListRow {
                            title: "Retry passes";
                            description: SettingsState.lyrics-failure-policy == 0
                                ? "How often skipped songs are asked again at the end, waiting longer each time (10 s, 30 s, 90 s, …)."
                                : "Used with \"Skip, retry at the end\".";
                            SpinBox {
                                width: 120px;
                                minimum: 1;
                                maximum: 10;
                                enabled: SettingsState.lyrics-failure-policy == 0;
                                value <=> SettingsState.lyrics-retry-passes;
                                edited(value) => {
                                    SettingsState.set-lyrics-retry-passes(value);
                                }
                            }
                        }
                    }
                }

                storage := Section {
                    title: "Storage";
                    ListRow {
                        title: "Data folder";
                        description: SettingsState.data-dir;
                        IconButton {
                            icon: Icons.folder;
                            tooltip: "Open the data folder";
                            clicked => {
                                SettingsState.open-data-dir();
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Capture Apple traffic to disk";
                        description: "For troubleshooting. Saved in the capture folder.";
                        Switch {
                            checked <=> ProxyState.capture;
                            enabled: ProxyState.running;
                            toggled => {
                                ProxyState.set-capture(self.checked);
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Capture folder";
                        description: SettingsState.captures-dir;
                        IconButton {
                            icon: Icons.folder;
                            tooltip: "Open the capture folder";
                            clicked => {
                                SettingsState.open-captures-dir();
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Clear cache";
                        description: "Delete cached Apple Music responses and artwork. Local audio, links to local files and custom songs are kept.";
                        ActionButton {
                            text: "Clear cache";
                            kind: "plain";
                            clicked => {
                                SettingsState.clear-cache();
                            }
                        }
                    }

                    RowSeparator { }

                    ListRow {
                        title: "Remove all data";
                        description: "Delete downloaded music, lyrics, artwork, settings and logs, remove the certificate and the start-at-login entry, and turn off Cider's proxy setting. The app quits afterwards.";
                        ActionButton {
                            text: "Remove all data…";
                            kind: "destructive";
                            enabled: !SettingsState.removing;
                            clicked => {
                                SettingsState.remove-all-data();
                            }
                        }
                    }
                }
            }
        }
    }
}
